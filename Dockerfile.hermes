ARG HERMES_AGENT_IMAGE=nousresearch/hermes-agent:latest
FROM ${HERMES_AGENT_IMAGE}

COPY hermes-config.yaml /opt/hermes/cli-config.yaml.example
COPY docker/hermes-entrypoint.sh /opt/hermes/docker/hermes-entrypoint.sh

RUN chmod +x /opt/hermes/docker/hermes-entrypoint.sh

EXPOSE 8642 9119

ENTRYPOINT ["/opt/hermes/docker/hermes-entrypoint.sh"]
