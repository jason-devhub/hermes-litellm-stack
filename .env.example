# Copie vers .env en local : cp .env.example .env
# Ne jamais committer .env (secrets).
#
# Sur Coolify : déclare ces variables dans l’application (onglet Environment),
# pas besoin de fichier .env dans le dépôt.

# Obligatoire pour LiteLLM avec l’alias fast-model (NVIDIA / Minimax via build.nvidia.com)
NVIDIA_API_KEY=

# Hermes → LiteLLM (optionnel : défauts = compose si non définies)
# Exemples : fast-model | nvidia-llama-3.1-8b | nvidia_nim/meta/llama-3.1-70b-instruct
#HERMES_LITELLM_BASE_URL=http://litellm:4000/v1
#HERMES_LITELLM_API_KEY=dummy
#HERMES_LITELLM_MODEL=fast-model
#HERMES_INFERENCE_PROVIDER=custom

# Authentification du serveur HTTP Hermes (UI + API), Bearer — voir README « Sécurité »
HERMES_API_SERVER_KEY=

# Optionnel : surcharger l’API HTTP Hermes (défauts = true / 0.0.0.0 / 8642)
#HERMES_API_SERVER_ENABLED=true
#HERMES_API_SERVER_HOST=0.0.0.0
#HERMES_API_SERVER_PORT=8642
# Port publié sur l’hôte (gauche du mapping) ; par défaut = même valeur que le port conteneur
#HERMES_PUBLISH_PORT=8642

# Optionnel : origines CORS pour l’UI (ex. https://hermes.example.com). Défaut * si non défini dans docker-compose.
HERMES_CORS_ORIGINS=

# Open WebUI (interface web connectée à Hermes via http://hermes:8642/v1)
# Sur Coolify, configure un domaine sur le service open-webui avec le port interne 8080.
# Recommandé : openssl rand -hex 32
OPENWEBUI_SECRET_KEY=
# Basic Auth Traefik sur l'interface publique Open WebUI — une entrée user:hash bcrypt par label (doc Coolify).
# Générer : htpasswd -nbB monuser monmotdepasse  →  coller la ligne complète (monuser:$2y$...).
# Dans .env : doubler chaque « $ » du hash (ex. $2y$ → $$2y$$) pour que Docker Compose n’interprète pas les dollars.
OPENWEBUI_BASIC_AUTH_USERS=username:$2y$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#OPENWEBUI_NAME=Hermes Agent
#OPENWEBUI_AUTH=true
#OPENWEBUI_OPENAI_API_BASE_URLS=http://hermes:8642/v1
#OPENWEBUI_OPENAI_API_KEYS=${HERMES_API_SERVER_KEY}

# Optionnels : seulement si tu utilises les alias reasoning-model, code-model, vision-model
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
