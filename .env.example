# Copie vers .env en local : cp .env.example .env
# Ne jamais committer .env (secrets).
#
# Sur Coolify : déclare ces variables dans l’application (onglet Environment),
# pas besoin de fichier .env dans le dépôt.

# Obligatoire — sans cette clé LiteLLM refuse de démarrer (fast-model → NVIDIA NIM)
# https://build.nvidia.com → API Key (format nvapi-...)
NVIDIA_API_KEY=

# Obligatoire — Hermes écoute sur 0.0.0.0 sans cette clé (gateway en boucle de redémarrage)
# Génération : openssl rand -hex 32
HERMES_API_SERVER_KEY=

# Hermes → LiteLLM (optionnel : défauts = compose si non définies)
# Exemples : fast-model | nvidia-llama-3.1-8b | nvidia_nim/meta/llama-3.1-70b-instruct
#HERMES_LITELLM_BASE_URL=http://litellm:4000/v1
#HERMES_LITELLM_API_KEY=dummy
#HERMES_LITELLM_MODEL=fast-model
#HERMES_INFERENCE_PROVIDER=custom

# Optionnel : surcharger l’API HTTP Hermes (défauts = true / 0.0.0.0 / 8642)
#HERMES_API_SERVER_ENABLED=true
#HERMES_API_SERVER_HOST=0.0.0.0
#HERMES_API_SERVER_PORT=8642
# Port publié sur l’hôte (gauche du mapping) ; par défaut = même valeur que le port conteneur
#HERMES_PUBLISH_PORT=8642

# UID/GID du volume partagé agent ↔ workspace (défaut 10010 = user « workspace » dans l’UI)
# Ne change que si tu personnalises l’image workspace ; après changement : redémarre hermes puis workspace.
#HERMES_UID=10010
#HERMES_GID=10010

# Dashboard Hermes (défaut 9119, réseau Docker interne uniquement)
#HERMES_DASHBOARD_HOST=0.0.0.0
#HERMES_DASHBOARD_PORT=9119
# Active l’onglet TUI dans le dashboard officiel si besoin.
#HERMES_DASHBOARD_TUI=1

# Image officielle Hermes source-built. À surcharger seulement pour pinner un tag/digest testé.
#HERMES_AGENT_IMAGE=nousresearch/hermes-agent:latest

# Optionnel : origines CORS pour l’UI (ex. https://hermes.example.com). Défaut * si non défini dans docker-compose.
HERMES_CORS_ORIGINS=

# Hermes Workspace (interface web — remplace Open WebUI)
# Sur Coolify : domaine sur le service hermes-workspace, port interne 3000.
# Obligatoire : mot de passe de session de l’UI (32+ caractères recommandés)
HERMES_PASSWORD=
# Défaut dans docker-compose : 0 (login OK en http://). Ne change que si tu sais pourquoi.
#HERMES_WORKSPACE_COOKIE_SECURE=0
# Si GHCR renvoie "denied: denied" au pull : identifiants locaux invalides → docker logout ghcr.io puis relance compose
#HERMES_WORKSPACE_IMAGE=ghcr.io/outsourc-e/hermes-workspace:latest
#HERMES_WORKSPACE_PORT=3000

# Optionnels : seulement si tu utilises les alias reasoning-model, code-model, vision-model
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
